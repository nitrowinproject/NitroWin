<?xml version="1.0" encoding="utf-8"?>
<root>
  <data name="CleanupError" xml:space="preserve">
    <value>[bold red]✗ Error while cleaning up after downloading tweaks:[/] {ex.Message}</value>
  </data>
  <data name="CleanupSuccess" xml:space="preserve">
    <value>[green]✓ Cleaned up successfully![/]</value>
  </data>
  <data name="StatusCleanup" xml:space="preserve">
    <value>Cleaning up...</value>
  </data>
  <data name="StatusUpdating" xml:space="preserve">
    <value>Updating tweaks...</value>
  </data>
  <data name="UpdateError" xml:space="preserve">
    <value>[bold red]✗ Error while applying tweaks:[/] {0}</value>
  </data>
  <data name="UpdateSuccess" xml:space="preserve">
    <value>[green]✓ Tweaks were successfully updated![/]</value>
  </data>
</root>
