<Window x:Class="NitroWin.ControlPanel.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NitroWin.ControlPanel.Views.Windows"
        xmlns:viewmodels="clr-namespace:NitroWin.ControlPanel.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="NitroWin Control Panel"
        Height="600"
        Width="800">
    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>
    <Grid ColumnDefinitions="Auto *"
          RowDefinitions="*">
        <Grid ColumnDefinitions="*"
              RowDefinitions="Auto Auto Auto * Auto">
            <Button Grid.Row="0"
                    Command="{Binding TweaksCommand}">
                Tweaks
            </Button>
            <Button Grid.Row="1"
                    Command="{Binding AppsCommand}">
                Apps
            </Button>
            <Button Grid.Row="2"
                    Command="{Binding ExtrasCommand}">
                Extras
            </Button>
            <Button Grid.Row="4"
                    Command="{Binding UpdatesCommand}">
                Updates
            </Button>
        </Grid>

        <ContentControl Content="{Binding CurrentView}"
                        Grid.Column="1"/>
    </Grid>
</Window>
