<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewmodels="clr-namespace:NitroWin.ControlPanel.ViewModels"
                    xmlns:views="clr-namespace:NitroWin.ControlPanel.Views">
    <DataTemplate DataType="{x:Type viewmodels:TweaksViewModel}">
        <views:TweaksView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:AppsViewModel}">
        <views:AppsView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:ExtrasViewModel}">
        <views:ExtrasView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewmodels:UpdatesViewModel}">
        <views:UpdatesView/>
    </DataTemplate>
</ResourceDictionary>
